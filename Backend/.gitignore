node_modules
# Keep environment variables out of version control
.env

/generated/prisma

dist

# Runtime logs (e.g. Backend/solver/uvicorn.log from local dev runs)
*.log

# Local SQLite database (offline conversion — each machine has its own)
prisma/*.db
prisma/*.db-journal

# PyInstaller build artifacts (solver/dist is already covered by the bare
# `dist` rule above) — regenerated by the packaging step, not committed.
solver/build
solver/*.spec
